NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_anon_key
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key

# Stripe - Clés à récupérer depuis dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (à créer dans le dashboard Stripe)
STRIPE_PRICE_YEARLY=price_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_TEST=price_...

# URL du site (pour les redirections Stripe - sans NEXT_PUBLIC car utilisé côté serveur)
SITE_URL=http://localhost:3000
